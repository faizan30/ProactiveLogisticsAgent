# Application
APP_ENV=development

# Database (Required)
POSTGRES_USER=admin
POSTGRES_PASSWORD=garage
POSTGRES_DB=logistics
# Use 'db' for Docker Compose, 'localhost' for local development/testing
POSTGRES_HOST=db
POSTGRES_PORT=5432

# OpenAI (Required for agent)
OPENAI_API_KEY=

# Langfuse (Optional - for observability)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

#Agent Configuration (Optional - defaults in src/config.py)
AGENT_SUPERVISOR_MODEL=gpt-5-mini
AGENT_SPECIALIST_MODEL=gpt-5-mini
AGENT_SUPERVISOR_TEMP=0.0
AGENT_SPECIALIST_TEMP=0.0
AGENT_MAX_TURNS=10


