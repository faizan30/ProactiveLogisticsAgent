# Application
APP_ENV=development

# Database (Required)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# POSTGRES_HOST=localhost
POSTGRES_HOST=
POSTGRES_PORT=5432

# OpenAI (Required for agent)
OPENAI_API_KEY=
# Langfuse (Optional - for observability)
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

#Agent Configuration (Optional - defaults in src/config.py)
AGENT_SUPERVISOR_MODEL=gpt-5-mini
AGENT_SPECIALIST_MODEL=gpt-5-mini
AGENT_SUPERVISOR_TEMP=0.0
AGENT_SPECIALIST_TEMP=0.0
AGENT_MAX_TURNS=10


