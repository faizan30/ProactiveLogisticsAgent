{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Debug API",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "uvicorn",
            "args": ["src.api.main:app", "--host", "0.0.0.0", "--port", "9001"],
            "env": {"POSTGRES_HOST": "localhost"},
            "jinja": true,
            "justMyCode": false
        },

        {
            "name": "Python: Remote Attach (Docker)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/app"
                }
            ],
            "justMyCode": false
        }
    ], 
}
